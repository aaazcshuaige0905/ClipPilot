# -----------------------------------------------------------------------------
# Python generated files
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging and build artifacts
build/
dist/
.eggs/
*.egg-info/
pip-wheel-metadata/

# -----------------------------------------------------------------------------
# Tests, coverage, lint and type-check caches
# Keep tests locally, but do not publish them to this repository.
# -----------------------------------------------------------------------------
/tests/
/tests_runtime/
/pytest.ini
.pytest_cache/
.pytest_tmp*/
.test_artifacts/
pytest-cache-files-*/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
.mypy_cache/
.ruff_cache/
.pyre/
.tox/
.nox/

# -----------------------------------------------------------------------------
# ClipPilot runtime output and generated data
# -----------------------------------------------------------------------------
/output/
/outputs/
/data/
/storage/
/uploads/
/temp/
/tmp/

# Runtime media and generated sidecar files at repository root
/*.mp4
/*.mov
/*.mkv
/*.avi
/*.wav
/*.mp3
/*.aac
/*.srt
/*.vtt
/*.log

# -----------------------------------------------------------------------------
# Local configuration and secrets
# Keep config.yaml as the safe, versioned default configuration.
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.secret
.python-version
/start-dev*.ps1
/start-dev*.ps1.example

# -----------------------------------------------------------------------------
# Editors, agent metadata and operating-system files
# -----------------------------------------------------------------------------
/.vscode/
/.idea/
/.agents/
/.codex/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
